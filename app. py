import pandas as pd
import streamlit as st

st.set_page_config(page_title="Netflix Recommendation System", page_icon="🎬", layout="wide")

st.title("🎬 Netflix Movie Recommendation System")
st.markdown("Explore Netflix movies & TV shows by genre. Built with Python, Pandas & Streamlit.")

# Load dataset from GitHub
DATA_URL = "https://raw.githubusercontent.com/khushigowdakhushi366-star/netflix-recommendation-system/main/netflix_titles.csv"
df = pd.read_csv(DATA_URL)

# Sidebar for user input
st.sidebar.header("Filter Movies / TV Shows")
genre_list = sorted(df['listed_in'].dropna().unique())
selected_genre = st.sidebar.selectbox("Select Genre", genre_list)

# Filter the dataset based on user input
filtered_df = df[df['listed_in'].str.contains(selected_genre, na=False)]

st.markdown(f"### Found {len(filtered_df)} movies / TV shows in **{selected_genre}** genre")

# Show top 20 results
st.dataframe(filtered_df[['title', 'release_year', 'type']].head(20))

# Optional: show summary metrics
st.sidebar.markdown("### Summary")
st.sidebar.write(f"Total Titles: {len(df)}")
st.sidebar.write(f"Filtered Titles: {len(filtered_df)}")
st.sidebar.write(f"Genres available: {len(genre_list)}")

